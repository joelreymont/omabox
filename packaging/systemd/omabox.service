[Unit]
Description=Omabox Dropbox sync service
After=graphical-session.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=notify
ExecStartPre=-/usr/bin/rm -f %t/omabox/status.json
ExecStart=%h/.local/bin/omaboxd
ExecStopPost=-/bin/sh -c 'if [ "$$SERVICE_RESULT" = success ]; then exec /usr/bin/rm -f "%t/omabox/status.json"; fi'
Restart=on-failure
RestartPreventExitStatus=70 78
RestartSec=5s
UMask=0077
KillSignal=SIGTERM
TimeoutStartSec=5min
TimeoutStopSec=30s

[Install]
WantedBy=default.target
